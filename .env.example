# Copy to .env.local for local development (npm run db:local-setup fills most of this in).
# In Railway, set these as service variables. See docs/ENVIRONMENT.md for details.

# --- Web service ------------------------------------------------------------
# App connection: the RESTRICTED role ft_app (subject to Row-Level Security).
DATABASE_URL=postgres://ft_app:CHANGE_ME@localhost:5432/finance_dev
# Privileged connection used ONLY for migrations (pre-deploy) and backups.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/finance_dev
# Password for ft_app, used by `npm run db:roles`.
APP_DB_PASSWORD=CHANGE_ME_AT_LEAST_24_CHARS
# Public origin of the app (CSRF origin check, cookies). Must match the browser URL exactly.
APP_URL=http://localhost:3100
# One-time secret for the first-time setup page. Remove after setup.
SETUP_TOKEN=CHANGE_ME_RANDOM_24_CHARS
# 32 random bytes, base64. Encrypts device recovery keys in the DB. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Optional
SESSION_IDLE_DAYS=14
SESSION_ABSOLUTE_DAYS=60
LOG_LEVEL=info

# Web Push (optional). Generate with: npm run vapid:keygen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Object storage (receipts + backups), any S3-compatible provider --------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Set to AES256 only on providers that support S3 server-side-encryption headers (AWS S3).
S3_SSE=

# --- Backup service ---------------------------------------------------------
# age PUBLIC key (age1...). Generate a key pair on your own computer: npm run backup:keygen
BACKUP_AGE_RECIPIENT=

# --- Local development / tests only -----------------------------------------
LOCAL_PG_SUPERUSER_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
