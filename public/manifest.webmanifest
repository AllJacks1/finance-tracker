{
  "id": "/app",
  "name": "Finance Tracker",
  "short_name": "Finance",
  "description": "Private, offline-first personal finance tracker.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8fbfa",
  "theme_color": "#0f9f7a",
  "lang": "en-PH",
